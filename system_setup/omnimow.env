# ==============================================================================
#             OMNIMOW HARDWARE & CHASSIS CONFIGURATION (Single Source of Truth)
# ==============================================================================
# The defaults (Worx Landroid M600 Plus). DO NOT EDIT ON THE MOWER: a software update replaces
# this file. Put this mower's own values in /etc/omnimow/robot.env instead - it is read after this
# file, so a value set there wins, and updates never touch it:
#   sudo bash system_setup/configure_robot.sh               asks for the robot's measurements
#   sudo bash system_setup/configure_robot.sh --set KEY=VALUE  any other setting from this file
# then: sudo bash system_setup/host_setup.sh

# --- CHASSIS DIMENSIONS & MOTOR CONTROL ---
# Worx Landroid M600 Plus standard = 0.40 (40 cm track width)
OMNIMOW_TRACK_WIDTH=0.40
# Robot-radius used for collision zone (meters)
OMNIMOW_ROBOT_RADIUS=0.28
# Robot outline for Nav2 (metres, x forward, y left, around base_link). A rectangle lets the mower
# drive close along the lawn edge, which a circle with ROBOT_RADIUS would not allow.
OMNIMOW_FOOTPRINT="[[0.30, 0.20], [0.30, -0.20], [-0.25, -0.20], [-0.25, 0.20]]"
# Safety margin in Nav2 costmap inflation (meters)
# SAFETY DISTANCE FOR ASYMMETRIC CUTTER HEAD (WORX CUT-TO-EDGE):
# Since the cutter head is positioned completely on the right side of the Worx chassis, we increase the standard inflation-radius
# from 0.35m to 0.48m (provides a solid 20 cm safety margin beyond the robot's physical body of 28 cm).
# This ensures that the rotating cutter disc never swings into walls, beds or pots during turns!
OMNIMOW_NAV2_INFLATION_RADIUS=0.48

# Autoro VESC CAN IDs
OMNIMOW_VESC_LEFT_ID=1
OMNIMOW_VESC_RIGHT_ID=2

# --- HARDWARE (found by host_setup.sh) ---
# auto: host_setup.sh finds the board - radxa (Dragon Q6A: AI on the NPU), x86 (mini PC: AI on
# the CPU), pi (Raspberry Pi, not tested: AI on the CPU, USB cameras only) - and writes what it
# found to /etc/omnimow/hardware.env. Set radxa, x86, pi or generic to choose yourself.
OMNIMOW_PLATFORM=auto

# --- 3D STEREO MIPI CSI CAMERA SPECIFICATIONS ---
# Standard baseline for IMX219 Binocular is 60mm (0.06m)
OMNIMOW_CAMERA_BASELINE=0.06
# Only used to sanity-check the stereo calibration; the real baseline and focal length
# are measured by calibrate_stereo.py

# --- SENSOR LOCATIONS (URDF OFFSETS IN METERS) ---
# Camera mounting height (Z) above ground on the mower
OMNIMOW_CAMERA_HEIGHT_Z=0.10
# Camera distance (X) forward relative to the robot's center of rotation (base_link)
OMNIMOW_CAMERA_OFFSET_X=0.25
# Camera pitch angle (Pitch) in radians (0.0 = horizontal, positive values point downward)
OMNIMOW_CAMERA_PITCH_Y=0.0

# Dual IMX219 cameras via libcamera with the fixed camera IDs from the device tree
# (list them with: cam -l), so left/right never swap between boots. If the calibration reports
# "Left and right camera are swapped", exchange the two IDs.
# auto: two USB cameras when they are plugged in (v4l2), otherwise the Radxa's MIPI cameras
# (libcamera). Or set libcamera, gstreamer or v4l2.
OMNIMOW_CAMERA_BACKEND=auto
OMNIMOW_CAMERA_ID_LEFT="/base/soc@0/cci@ac4b000/i2c-bus@1/camera@10"
OMNIMOW_CAMERA_ID_RIGHT="/base/soc@0/cci@ac4b000/i2c-bus@0/camera@10"
# true: the camera pair is mounted upside down (test rig). Both images are turned 180 degrees and
# left/right swap automatically, the IDs above stay those of the upright mount. Recalibrate after
# changing it.
OMNIMOW_CAMERA_UPSIDE_DOWN=true
# Video nodes for the gstreamer (v4l2src) and v4l2 backends, e.g. /dev/video2 and /dev/video3.
# Empty: USB cameras are found by the USB port they are in (/dev/v4l/by-path/...); if left and
# right are swapped, swap the two USB plugs.
OMNIMOW_CAMERA_DEVICE_LEFT=
OMNIMOW_CAMERA_DEVICE_RIGHT=
# Format requested from the camera ISP (NV12 at 1920 x 1080); scaled to WIDTH x HEIGHT below.
# Not used with OMNIMOW_CAMERA_GPU_SCALE=true.
OMNIMOW_CAMERA_SENSOR_WIDTH=1920
OMNIMOW_CAMERA_SENSOR_HEIGHT=1080
# Empty: the camera picks the format and videoconvert turns it into BGR. The test image
# (rafaelwms Ubuntu 26.04, mainline kernel) has libcamera's software ISP, which has no NV12.
# NV12 on Radxa OS R2 (Qualcomm camera stack).
OMNIMOW_CAMERA_FORMAT=
# libcamera's software ISP (mainline kernel): debayer on the CPU or on the Adreno GPU (OpenGL ES,
# Mesa freedreno). gpu: 3-5 ms instead of 12-25 ms CPU per frame on the Dragon Q6A (Mesa 25.2).
# If the cameras do not open with gpu, set cpu.
LIBCAMERA_SOFTISP_MODE=gpu
# true (needs gpu above): the GPU debayer scales the whole sensor frame to WIDTH x HEIGHT itself.
# libcamera then runs the IMX219s in their 1640x1232 binned mode: full field of view, less noise,
# and no 1080p conversion on the CPU. WIDTH x HEIGHT must then be 4:3 (640 x 480).
# false: the camera delivers SENSOR_WIDTH x HEIGHT and GStreamer scales it on the CPU (16:9).
# Changing this changes the picture: delete the calibration and recalibrate.
OMNIMOW_CAMERA_GPU_SCALE=true

# --- STEREO CALIBRATION (runs automatically on first boot) ---
# Camera resolution used for calibration and at runtime: 4:3 with OMNIMOW_CAMERA_GPU_SCALE=true,
# 16:9 (640 x 360) like the 1920 x 1080 sensor format without it
OMNIMOW_CAMERA_WIDTH=640
OMNIMOW_CAMERA_HEIGHT=480
# Width of the colour image for the AI (same aspect as above, the left camera delivers it at this size and the
# stereo node scales it down to the size above). 800 = the model's input width, so the model
# gets the image without upscaling. Empty or <= OMNIMOW_CAMERA_WIDTH: use the stereo image.
OMNIMOW_AI_IMAGE_WIDTH=800
# Stereo matching. Closest depth = focal * baseline / disparities, in the stereo node's start-up
# log (96: about 0.5 m with the 1080p crop at 640x360, nearer with the full field of view). More disparities cost time and leave that many columns at the
# left edge without depth. Mode: 3way (multithreaded, fast), sgbm or hh4.
OMNIMOW_STEREO_NUM_DISPARITIES=96
OMNIMOW_STEREO_MODE=3way
# Stereo frames per second (the cameras deliver about 15). Each frame also costs work in the AI
# (depth_fusion) and SLAM, so 10 is a good balance for a slow mower. OpenCV threads for the stereo.
OMNIMOW_STEREO_FPS=10
# Frame rate of the cameras (empty = their own: about 60 in the 1640x1232 mode). Set on the
# sensors directly. Every frame costs ISP work even if the stereo node skips it, but the two
# cameras free-run, so a left/right pair can be up to half a frame interval apart: 30 FPS keeps
# that under 17 ms (10 FPS: 50 ms, too much while the mower turns).
OMNIMOW_CAMERA_FPS=30
OMNIMOW_STEREO_THREADS=4
# Checkerboard: inner corners (10 x 7 = a board of 11 x 8 squares) and square size in metres.
# A4 board from https://markhedleyjones.com/projects/calibration-checkerboard-collection
# (A4, 25 mm squares, 10x7 vertices), printed at 100 % scale
OMNIMOW_CALIB_BOARD_COLS=10
OMNIMOW_CALIB_BOARD_ROWS=7
OMNIMOW_CALIB_BOARD_SQUARE=0.025
OMNIMOW_CALIB_SAMPLES=30
# Lens model: rational (8 coefficients, follows the strong distortion in the corners of the full
# ~72 degree field of view) or standard (5, plumb_bob)
OMNIMOW_CALIB_MODEL=rational
# A view is only taken once the board moved less than this many pixels between two frames
OMNIMOW_CALIB_STILL_PX=0.5

# --- VISUAL SLAM (RTAB-Map) ---
# mapping: keep extending the garden map. localization: only localize (use once the map is complete).
# Always start from the charging station - the map origin is where the first session started.
OMNIMOW_SLAM_MODE=mapping

# --- AI LAWN EDGE ---
# Mark ground that is not grass (pavement, soil, gravel) as an obstacle so the mower stays on the lawn
OMNIMOW_AI_GRASS_BOUNDARY=true

# --- MOWING ---
# Worx Landroid M600 cutting width (m) and overlap between stripes (m)
OMNIMOW_CUT_WIDTH=0.18
OMNIMOW_MOW_OVERLAP=0.03
# Distance from the recorded zone edge to the mower's centre on the perimeter pass (m).
# 0.0 when zones are recorded by driving the mower along the lawn edge (the recorded path already
# is the mower's centre line); ~0.2 if a zone is drawn on the actual edge of the grass.
OMNIMOW_MOW_EDGE_MARGIN=0.0
OMNIMOW_MOW_PERIMETER_PASSES=1
# Blade speed in ERPM sent to the cutter VESC (blade RPM x motor pole pairs). CHECK FOR YOUR MOTOR.
OMNIMOW_CUTTER_ERPM=25000
# Return to charge below this state of charge (0-1) and resume mowing above this
OMNIMOW_MOW_BATTERY_RETURN=0.25
OMNIMOW_MOW_BATTERY_RESUME=0.95
# Seconds without a hazard (dog) in view before mowing continues
OMNIMOW_MOW_HAZARD_CLEAR_SEC=5
# Automatic lawn mapping (edge following): distance from the mower's centre to the lawn edge (m)
# and the maximum time for one loop around the lawn
OMNIMOW_EDGE_DISTANCE=0.28
OMNIMOW_AUTO_MAP_MAX_MIN=60

# --- HOST ---
# false: the board boots without the desktop (GNOME), which leaves its RAM and CPU to the stack.
# true: boot into the desktop again. Takes effect after re-running host_setup.sh and a reboot.
OMNIMOW_DESKTOP=false

# --- SOFTWARE UPDATES ---
# The mower checks this repository for a new GitHub release (made from main) every
# OMNIMOW_SOFTWARE_CHECK_MIN minutes and tells the app, which can then install it.
OMNIMOW_SOFTWARE_REPO="Ragsie/OmniMow"
OMNIMOW_SOFTWARE_CHECK_MIN=60

# --- PORTAINER (web UI for the Docker containers) ---
# https://<mower-ip>:9443 - create the admin user within 5 minutes of the first start, otherwise
# Portainer locks itself: then run 'docker restart portainer' and try again.
# Only 9443 is published: Portainer's own 8000/9000 would clash with rosbridge and app_backend.
OMNIMOW_PORTAINER=true
OMNIMOW_PORTAINER_PORT=9443

# --- AI MODEL (automatic updates) ---
# The mower installs the model file attached to the newest GitHub release of this repository and
# checks for a newer one shortly after boot and then every OMNIMOW_MODEL_CHECK_MIN minutes. A new
# model is swapped in while running; publish a new release with the file to roll it out.
# Private repository: GitHub token in /etc/omnimow/github_token.
OMNIMOW_MODEL_REPO="Ragsie/OmniMow"
# QNN context binary for the Radxa NPU, and the ONNX model for the CPU (x86, Raspberry Pi).
# Attach both to a release; each mower installs the one that suits its hardware.
OMNIMOW_MODEL_ASSET="MowerAIn_seg_htp_context.bin"
OMNIMOW_MODEL_ASSET_ONNX="MowerAIn_seg.onnx"
OMNIMOW_MODEL_CHECK_MIN=60

# --- MLOPS / LOCAL NFS AI TRAINING SERVER ---
# Specify the IP address of your local GPU training server (e.g., 192.168.1.100)
# Leave empty (""), if you don't use a local server and save images locally on the mower's NVMe SSD.
OMNIMOW_NFS_SERVER_IP=""

# Path to NFS share on your GPU server where images should be uploaded (e.g., /mnt/nfs/omnimow_raw)
OMNIMOW_NFS_SHARE="/mnt/nfs/omnimow_raw"