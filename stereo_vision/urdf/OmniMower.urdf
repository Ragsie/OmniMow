<?xml version="1.0"?>
<robot name="omnimower">
  <!-- Main chassis (base_link) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.6 0.4 0.3"/>
      </geometry>
      <material name="orange">
        <color rgba="1.0 0.5 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <!-- 3D Stereo Vision Camera Joint -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- Dynamic parameters are extracted from the launch file and injected here -->
    <origin xyz="{CAMERA_OFFSET_X} 0.0 {CAMERA_HEIGHT_Z}" rpy="0.0 {CAMERA_PITCH_Y} 0.0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.12 0.03"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Optical frame of the (rectified) left camera: Z forward, X right, Y down.
       All stereo images, camera_info and the depth image are stamped in this frame. -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0.0 0.0 0.0" rpy="-1.5707963 0.0 -1.5707963"/>
  </joint>

  <link name="camera_optical_frame"/>

  <!-- BNO085 IMU on the drive controller board -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="imu_link"/>
</robot>